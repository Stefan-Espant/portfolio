---
import Nav from '../components/Nav.wald'
import Footer from '../components/Footer.wald'
import CommandPalette from '../components/CommandPalette.wald'
import { readFileSync } from 'node:fs'
import { t, type Locale } from '../lib/i18n'
import { SITE_NAME, absoluteUrl } from '../lib/site'
import { jsonLdScript, personNode, websiteNode } from '../lib/seo'
import { feedPath, ogImagePath } from '../lib/extras'
type Props = {
  title: string
  /** true: titel zoals hij is, zonder " — Stefan van der Kort" (de home). */
  fullTitle?: boolean
  description?: string
  /** Pad van deze pagina, bv. "/werk": voor canonical en og:url. */
  path: string
  locale: Locale
  /** Deze pagina in elke taal waarin hij bestaat: voor hreflang en de taalwissel. */
  alternates?: Partial<Record<Locale, string>>
  current?: 'work' | 'blog' | 'about' | 'contact'
  noindex?: boolean
  /** 'article' voor blogposts (met publishedTime); anders 'website'. */
  ogType?: 'website' | 'article'
  publishedTime?: string
  /** Extra schema.org-nodes voor deze pagina; Person en WebSite staan er altijd in. */
  jsonLd?: Array<Record<string, unknown>>
  pond?: unknown
}
const { title, fullTitle = false, description = '', path, locale, alternates = {}, current, noindex = false, ogType = 'website', publishedTime = '', jsonLd = [], pond } = $$props
// De naam staat vast in de code (SITE_NAME); de siteName uit Centaur ('Mijn website') wordt niet gebruikt.
const documentTitle = fullTitle ? title : `${title} — ${SITE_NAME}`
const canonical = absoluteUrl(path)

const hreflang = Object.entries(alternates).map(([lang, href]) =>
  renderTemplate`<link rel="alternate" hreflang="${lang}" href="${absoluteUrl(String(href))}">`)
if (alternates.nl) hreflang.push(renderTemplate`<link rel="alternate" hreflang="x-default" href="${absoluteUrl(alternates.nl)}">`)

const headTags = [
  description ? renderTemplate`<meta name="description" content="${description}">` : '',
  noindex ? '<meta name="robots" content="noindex, follow">' : '',
  renderTemplate`<link rel="canonical" href="${canonical}">`,
  renderTemplate`<meta name="author" content="${SITE_NAME}">`,
  renderTemplate`<meta property="og:site_name" content="${SITE_NAME}">`,
  renderTemplate`<meta property="og:type" content="${ogType}">`,
  renderTemplate`<meta property="og:title" content="${documentTitle}">`,
  publishedTime ? renderTemplate`<meta property="article:published_time" content="${publishedTime}">` : '',
  publishedTime ? renderTemplate`<meta property="article:author" content="${SITE_NAME}">` : '',
  description ? renderTemplate`<meta property="og:description" content="${description}">` : '',
  renderTemplate`<meta property="og:url" content="${canonical}">`,
  renderTemplate`<meta property="og:locale" content="${({ nl: 'nl_NL', en: 'en_GB', de: 'de_DE' } as const)[locale]}">`,
  // Social-afbeelding per pagina; src/build/extras.ts maakt het bestand na de build.
  renderTemplate`<meta property="og:image" content="${absoluteUrl(ogImagePath(path))}">`,
  '<meta property="og:image:width" content="1200">',
  '<meta property="og:image:height" content="630">',
  '<meta name="twitter:card" content="summary_large_image">',
  renderTemplate`<meta name="twitter:title" content="${documentTitle}">`,
  description ? renderTemplate`<meta name="twitter:description" content="${description}">` : '',
  renderTemplate`<link rel="alternate" type="application/rss+xml" title="${SITE_NAME} — blog" href="${absoluteUrl(feedPath(locale))}">`,
  ...hreflang,
  noindex ? '' : jsonLdScript([personNode(locale), websiteNode(locale), ...jsonLd])
].filter(Boolean).join('\n    ')

// Fonts, Byzantium-basis, thema en basis-CSS zijn klein: inline in <head> in plaats van een blokkerende
// stylesheet. Volgorde telt: tokens.css overschrijft de Byzantium-waarden. "</" escapen zodat CSS de
// <style> nooit kan sluiten.
const CSS_FILES = [
  'src/styles/fonts.css',
  'src/styles/byzantium/root.css',
  'src/styles/byzantium/reset.css',
  'src/styles/byzantium/focus.css',
  'src/styles/byzantium/sr-only.css',
  'src/styles/byzantium/view-transitions.css',
  'src/styles/tokens.css',
  'src/styles/base.css'
]
const inlineCss = `<style data-wald-no-hoist>${CSS_FILES
  .map(file => readFileSync(file, 'utf8')).join('\n').replace(/<\//g, '<\\/')}</style>`

// Het inline script draait vóór de eerste paint:
// 1. Thema: de eigen keuze (localStorage, gezet door /theme.js) of anders de systeeminstelling.
// 2. Beweging: `motion` op <html> laat alleen de home-intro wachten op het motion-script. Start dat
//    niet binnen 3 s, dan gaat de class eraf: inhoud blijft nooit onzichtbaar.
const headScript = `<script data-wald-no-hoist>(function(){var d=document.documentElement,t;try{t=localStorage.getItem('theme')}catch(e){}d.dataset.theme=t==='dark'||t==='light'?t:matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light';if(matchMedia('(prefers-reduced-motion: reduce)').matches)return;d.classList.add('motion');setTimeout(function(){if(!window.__motionReady)d.classList.remove('motion')},3000)})()</script>
    <script src="/theme.js" defer data-wald-no-hoist></script>
    <script src="/vendor/gsap.min.js" defer data-wald-no-hoist></script>
    <script src="/vendor/ScrollTrigger.min.js" defer data-wald-no-hoist></script>
    <script src="/vendor/SplitText.min.js" defer data-wald-no-hoist></script>
    <script type="module" src="/motion/index.js" data-wald-no-hoist></script>
    <script type="module" src="/palette/palette.js" data-wald-no-hoist></script>`

const nav = await Nav.render({ locale, alternates, current })
const footer = await Footer.render({ locale })
const palette = await CommandPalette.render({ locale, alternates })
---
<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{documentTitle}</title>
    {new SafeHtml(headTags)}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#3046ff" />
    <link rel="preload" href="/fonts/bricolage-grotesque-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    {new SafeHtml(inlineCss)}
    {new SafeHtml(headScript)}
  </head>
  <body>
    <a class="skip-link" href="#main">{t('skip', locale)}</a>
    {new SafeHtml(nav)}
    {pond}
    {new SafeHtml(footer)}
    {new SafeHtml(palette)}
  </body>
</html>
