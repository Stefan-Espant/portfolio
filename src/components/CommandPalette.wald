---
// Commandopalet (spec 2026-10-12, Extra's): ⌘K / Ctrl+K of de zoekknop in de nav opent een <dialog> met een
// combobox over pagina's, projecten, artikelen en de taalwissel. De index staat inline in de pagina, zodat
// hij ook in `wald grow` werkt. Zonder JavaScript is er gewone navigatie en blijft de knop verborgen.
import { getPosts, getProjects } from '../lib/content'
import { langSwitchHref, localePath, otherLocale, plain, t, type Locale, type MessageKey } from '../lib/i18n'
type Props = { locale: Locale, alternates: Partial<Record<Locale, string>> }
const { locale, alternates } = $$props
const [projects, posts] = await Promise.all([getProjects(locale), getPosts(locale)])
const pages = t('palette.pages', locale)
const items = [
  { label: 'Home', group: pages, href: localePath('home', locale) },
  ...(['work', 'blog', 'about', 'contact'] as const).map(route => ({ label: t(`nav.${route}` as MessageKey, locale), group: pages, href: localePath(route, locale) })),
  ...projects.map(project => ({ label: project.title, group: t('palette.projects', locale), href: localePath('project', locale, project.slug), keywords: [t(`type.${project.type}` as MessageKey, locale), ...project.stack].join(' ') })),
  ...posts.map(post => ({ label: post.title, group: t('palette.posts', locale), href: localePath('post', locale, post.slug), keywords: post.tags.join(' ') })),
  { label: plain(t('lang.label', locale)), group: t('palette.language', locale), href: langSwitchHref(alternates, locale), lang: otherLocale(locale) }
]
// JSON in een <script>: "<" escapen zodat een titel de tag nooit kan sluiten.
const index = JSON.stringify(items).replace(/</g, '\\u003c')
// WaldJS vult niets in binnen <script>; daarom de hele tag hier bouwen.
const indexTag = `<script type="application/json" data-palette-index data-wald-no-hoist>${index}</script>`
---
<dialog class="palette" data-palette aria-label={t('palette.label', locale)}>
  <div class="palette__box">
    <input class="palette__input" type="text" role="combobox" aria-expanded="true" aria-controls="palette-list" aria-autocomplete="list" aria-label={t('palette.label', locale)} placeholder={t('palette.placeholder', locale)} autocomplete="off" spellcheck="false" />
    <ul class="palette__list" id="palette-list" role="listbox" aria-label={t('palette.label', locale)}></ul>
    <p class="palette__empty" data-palette-empty hidden>{t('palette.empty', locale)}</p>
    <p class="palette__hint" aria-hidden="true">{t('palette.hint', locale)}</p>
  </div>
</dialog>
{new SafeHtml(indexTag)}

<style>
.palette {
  width: min(40rem, calc(100vw - 2rem));
  max-height: min(34rem, calc(100dvh - 4rem));
  margin: 12vh auto auto;
  padding: 0;
  border: 0;
  border-radius: var(--radius);
  background: var(--card);
  color: var(--ink);
  box-shadow: 0 30px 80px -20px rgb(11 14 74 / 0.45);

  &::backdrop {
    background: rgb(15 15 18 / 0.45);
  }
  & .palette__box {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    max-height: inherit;
  }
  & .palette__input {
    width: 100%;
    padding: 1.1rem 1.25rem;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: transparent;
    color: var(--ink);
    font: 500 1.125rem/1.3 var(--font-sans);
  }
  & .palette__input:focus-visible {
    outline: none;
  }
  & .palette__list {
    overflow-y: auto;
    padding: var(--space-2);
    list-style: none;
  }
  & .palette__group {
    padding: var(--space-3) var(--space-3) var(--space-1);
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  & .palette__option {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 0.65rem 0.75rem;
    border-radius: 10px;
    cursor: pointer;
  }
  & .palette__option[aria-selected='true'] {
    background: var(--ink);
    color: var(--bg);
  }
  & .palette__option span {
    opacity: 0.6;
    font-size: var(--text-sm);
  }
  & .palette__empty,
  & .palette__hint {
    padding: var(--space-3) 1.25rem;
    color: var(--muted);
    font-size: var(--text-sm);
  }
  & .palette__hint {
    border-top: 1px solid var(--line);
  }
}
</style>
