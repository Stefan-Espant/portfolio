---
import Logo from './Logo.wald'
import { LANGUAGE_NAMES, LOCALES, langHref, localePath, t, type Locale, type MessageKey } from '../lib/i18n'
type NavRoute = 'work' | 'blog' | 'about' | 'contact'
type Props = {
  locale: Locale
  /** Dezelfde pagina in andere talen; de taalwissel linkt daarheen. */
  alternates: Partial<Record<Locale, string>>
  current?: 'work' | 'blog' | 'about' | 'contact'
}
const { locale, alternates, current } = $$props
const routes: Array<[NavRoute, MessageKey]> = [['work', 'nav.work'], ['blog', 'nav.blog'], ['about', 'nav.about'], ['contact', 'nav.contact']]
const items = routes.map(([route, label]) => {
  const ariaCurrent = new SafeHtml(route === current ? ' aria-current="page"' : '')
  return renderTemplate`<li><a class="nav__link" href="${localePath(route, locale)}"${ariaCurrent}>${t(label, locale)}</a></li>`
}).join('')
// Mobiel menu (overlay): dezelfde routes, groot, met een volgnummer; de huidige pagina cursief.
const bigItems = routes.map(([route, label], index) => {
  const ariaCurrent = new SafeHtml(route === current ? ' aria-current="page"' : '')
  return renderTemplate`<li><a class="nav__big-link" href="${localePath(route, locale)}"${ariaCurrent}><span>${t(label, locale)}</span><sup aria-hidden="true">0${String(index + 1)}</sup></a></li>`
}).join('')
const overlayLanguages = LOCALES.map(target => {
  const current = new SafeHtml(target === locale ? ' aria-current="true"' : '')
  return renderTemplate`<a class="nav__overlay-lang" href="${langHref(alternates, target)}" hreflang="${target}" lang="${target}" aria-label="${LANGUAGE_NAMES[target]}"${current}>${target.toUpperCase()}</a>`
}).join('')
// Taalmenu: <details> werkt zonder JavaScript; /lang-menu.js sluit het bij Esc of een klik ernaast.
const languages = LOCALES.map(target => {
  const current = new SafeHtml(target === locale ? ' aria-current="true"' : '')
  return renderTemplate`<li><a class="nav__lang-link" href="${langHref(alternates, target)}" hreflang="${target}" lang="${target}"${current}><span>${LANGUAGE_NAMES[target]}</span><span class="nav__lang-code" aria-hidden="true">${target.toUpperCase()}</span></a></li>`
}).join('')
const langMenu = renderTemplate`<details class="nav__lang" data-lang-menu>
  <summary class="nav__pill nav__lang-btn" aria-label="${t('lang.label', locale)}: ${LANGUAGE_NAMES[locale]}"><span aria-hidden="true">${locale.toUpperCase()}</span><svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true"><path d="m2 3.5 3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></summary>
  <ul class="nav__lang-list" role="list">${new SafeHtml(languages)}</ul>
</details>`
---
<header class="nav container">
  <a class="nav__home" href={localePath('home', locale)}><Logo height={34} /></a>
  <nav class="nav__menu" aria-label={t('nav.label', locale)} data-motion="nav">
    <span class="nav__indicator" aria-hidden="true"></span>
    <ul class="nav__list" role="list">{new SafeHtml(items)}</ul>
  </nav>
  <div class="nav__tools">
    <button class="nav__pill nav__search" type="button" data-palette-open aria-label={t('palette.open', locale)} aria-keyshortcuts="Meta+K Control+K" hidden>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.6"/><path d="m11 11 3.5 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      <kbd class="nav__kbd">⌘K</kbd>
    </button>
    {new SafeHtml(langMenu)}
    <button class="nav__pill nav__theme" type="button" data-theme-toggle aria-pressed="false" aria-label={t('theme.label', locale)} hidden>
      <span class="nav__moon" aria-hidden="true">☾</span><span class="nav__sun" aria-hidden="true">☀</span>
    </button>
    <button class="nav__pill nav__menu-btn" type="button" data-nav-open aria-haspopup="dialog" aria-controls="nav-overlay">
      <span class="nav__burger" aria-hidden="true"><i></i><i></i><i></i></span>{t('nav.menu', locale)}
    </button>
  </div>
  <dialog class="nav__overlay" id="nav-overlay" aria-label={t('nav.label', locale)} data-nav-overlay>
    <div class="nav__overlay-top">
      <a class="nav__overlay-home" href={localePath('home', locale)}><Logo height={34} /></a>
      <button class="nav__pill nav__overlay-close" type="button" data-nav-close aria-label={t('nav.close', locale)}>✕</button>
    </div>
    <nav aria-label={t('nav.label', locale)}>
      <ul class="nav__big" role="list">{new SafeHtml(bigItems)}</ul>
    </nav>
    <div class="nav__overlay-foot">
      <div class="nav__overlay-langs" role="group" aria-label={t('lang.label', locale)}>{new SafeHtml(overlayLanguages)}</div>
      <button class="nav__overlay-tool" type="button" data-nav-theme aria-label={t('theme.label', locale)}><span class="nav__moon" aria-hidden="true">☾</span><span class="nav__sun" aria-hidden="true">☀</span></button>
      <button class="nav__overlay-tool" type="button" data-nav-search>{t('palette.open', locale)} <kbd aria-hidden="true">⌘K</kbd></button>
    </div>
  </dialog>
</header>
<script src="/lang-menu.js" defer data-wald-no-hoist></script>
<script src="/nav-menu.js" defer data-wald-no-hoist></script>

<style>
/* Links, taalwissel en knop worden deels in de frontmatter gebouwd: genest onder .nav gestyled. */
.nav {
  position: relative;
  z-index: 20;
  display: grid;
  grid-template-columns: 1fr auto;
  grid-template-areas:
    'home tools'
    'menu menu';
  align-items: center;
  gap: var(--space-3) var(--space-4);
  padding-block: var(--space-4);
  font-size: var(--text-sm);
  font-weight: 500;

  & .nav__home {
    grid-area: home;
    justify-self: start;
    display: inline-flex;
    align-items: center;
  }
  & .nav__menu {
    grid-area: menu;
    position: relative;
    justify-self: start;
    max-width: 100%;
    padding: 4px;
    border-radius: var(--pill);
    background: var(--card);
    box-shadow: var(--edge);
    overflow-x: auto;
  }
  /* Niet gepositioneerd: zo meet motion.js de links ten opzichte van het menu, net als de indicator. */
  & .nav__list {
    display: flex;
    gap: 2px;
    list-style: none;
  }
  & .nav__link {
    position: relative;
    z-index: 1;
    display: block;
    padding: 0.45rem 0.95rem;
    border-radius: var(--pill);
    white-space: nowrap;
    transition: color 0.3s;
  }
  /* Zonder JavaScript (of vóór de start) markeert de huidige link zichzelf; motion.js neemt het over
     met de glijdende indicator en zet dan .is-gliding op het menu. */
  & .nav__link[aria-current='page'] {
    background: var(--ink);
    color: var(--bg);
  }
  & .nav__menu.is-gliding .nav__link[aria-current='page'] {
    background: none;
    color: inherit;
  }
  & .nav__menu.is-gliding .nav__link.is-under {
    color: var(--bg);
  }
  & .nav__indicator {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 0;
    width: 0;
    border-radius: var(--pill);
    background: var(--ink);
    opacity: 0;
  }
  & .nav__tools {
    grid-area: tools;
    display: flex;
    gap: var(--space-2);
  }
  & .nav__pill {
    display: grid;
    place-items: center;
    min-width: 2.5rem;
    height: 2.5rem;
    padding-inline: 0.75rem;
    border: 0;
    border-radius: var(--pill);
    background: var(--card);
    box-shadow: var(--edge);
    color: var(--ink);
    font: inherit;
    cursor: pointer;
  }
  /* Taalmenu */
  & .nav__lang {
    position: relative;
  }
  & .nav__lang-btn {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    list-style: none;
  }
  & .nav__lang-btn::-webkit-details-marker {
    display: none;
  }
  & .nav__lang[open] .nav__lang-btn svg {
    rotate: 180deg;
  }
  & .nav__lang-list {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    z-index: 30;
    display: grid;
    gap: 2px;
    min-width: 11rem;
    padding: 6px;
    list-style: none;
    border-radius: 16px;
    background: var(--card);
    box-shadow: var(--edge), 0 18px 40px -18px rgb(11 14 74 / 0.35);
  }
  & .nav__lang-link {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 0.55rem 0.75rem;
    border-radius: 10px;
  }
  & .nav__lang-link:hover {
    background: var(--bg);
  }
  & .nav__lang-link[aria-current] {
    background: var(--ink);
    color: var(--bg);
  }
  & .nav__lang-code {
    color: var(--muted);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }
  & .nav__lang-link[aria-current] .nav__lang-code {
    color: inherit;
    opacity: 0.7;
  }
  & .nav__theme {
    padding: 0;
    font-size: 1rem;
  }
  & .nav__theme[hidden],
  & .nav__search[hidden] {
    display: none;
  }
  & .nav__search {
    display: flex;
    gap: var(--space-2);
  }
  & .nav__kbd {
    display: none;
    font: inherit;
    font-size: 0.75rem;
    color: var(--muted);
  }
  @media (min-width: 64rem) {
    & .nav__kbd {
      display: inline;
    }
  }
  & .nav__sun {
    display: none;
  }
}
[data-theme='dark'] .nav .nav__moon { display: none; }
[data-theme='dark'] .nav .nav__sun { display: inline; }

/* Mobiel menu (overlay). De knop en de overlay bestaan alleen met JavaScript (.js op <html>, gezet in <head>
   vóór de eerste paint); zonder JavaScript blijft de pil met links gewoon onder het logo staan. */
.nav {
  & .nav__menu-btn,
  & .nav__overlay:not([open]) {
    display: none;
  }
  & .nav__menu-btn {
    gap: 0.5rem;
    align-items: center;
    font-weight: 600;
  }
  & .nav__burger {
    display: grid;
    gap: 3px;
    width: 14px;
  }
  & .nav__burger i {
    display: block;
    height: 1.5px;
    border-radius: 1px;
    background: currentColor;
  }
  & .nav__overlay {
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: var(--space-4) var(--page-gutter) max(var(--space-6), env(safe-area-inset-bottom));
    border: 0;
    color: var(--ink);
    background:
      radial-gradient(80% 45% at 100% 0%, color-mix(in srgb, var(--accent) 28%, transparent), transparent 70%),
      var(--bg);
  }
  & .nav__overlay[open] {
    display: grid;
    grid-template-rows: auto 1fr auto;
  }
  & .nav__overlay::backdrop {
    background: var(--bg);
  }
  & .nav__overlay-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  & .nav__overlay-close {
    font-size: 1rem;
  }
  & .nav__overlay nav {
    align-self: center;
  }
  & .nav__big {
    display: grid;
    gap: 0.35rem;
    list-style: none;
  }
  & .nav__big-link {
    display: inline-flex;
    align-items: flex-start;
    gap: 0.5rem;
    padding-block: 0.1em;
    font-family: var(--font-display);
    font-size: clamp(3rem, 15vw, 5.5rem);
    font-weight: 600;
    font-stretch: 85%;
    letter-spacing: -0.05em;
    line-height: 0.85;
  }
  & .nav__big-link sup {
    margin-top: 0.4em;
    font-family: var(--font-body, Inter, sans-serif);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--muted);
  }
  & .nav__big-link[aria-current='page'] span {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.03em;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  & .nav__overlay-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
    font-size: var(--text-sm);
  }
  & .nav__overlay-langs {
    display: flex;
    gap: var(--space-2);
  }
  & .nav__overlay-lang,
  & .nav__overlay-tool {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.5rem;
    padding: 0 0.85rem;
    border: 0;
    border-radius: var(--pill);
    background: var(--card);
    color: var(--ink);
    font: inherit;
    cursor: pointer;
  }
  & .nav__overlay-lang[aria-current] {
    background: var(--ink);
    color: var(--bg);
  }
  & .nav__overlay-tool kbd {
    font: inherit;
    font-size: 0.75rem;
    color: var(--muted);
  }

  @media (prefers-reduced-motion: no-preference) {
    & .nav__overlay[open] .nav__big li {
      animation: nav-rise 0.6s var(--ease-out) both;
    }
    & .nav__overlay[open] .nav__big li:nth-child(2) { animation-delay: 0.05s; }
    & .nav__overlay[open] .nav__big li:nth-child(3) { animation-delay: 0.1s; }
    & .nav__overlay[open] .nav__big li:nth-child(4) { animation-delay: 0.15s; }
  }
}
@keyframes nav-rise {
  from { opacity: 0; transform: translateY(0.6em); }
}

/* Mobiel met JavaScript: alleen logo + Menu; links, taal, thema en zoeken zitten in de overlay. */
@media (max-width: 47.99rem) {
  .js .nav {
    grid-template-areas: 'home tools';

    & .nav__menu,
    & .nav__lang,
    & .nav__theme,
    & .nav__search {
      display: none;
    }
    & .nav__menu-btn {
      display: flex;
    }
  }
}

/* Vanaf tablet alles op één regel, het menu in het midden. */
@media (min-width: 48rem) {
  .nav {
    grid-template-columns: 1fr auto 1fr;
    grid-template-areas: 'home menu tools';

    & .nav__tools {
      justify-self: end;
    }
  }
}
</style>
