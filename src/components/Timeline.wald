---
// Proces als tijdlijn (spec: Motion, `timeline`). Statisch: verticale tijdlijn met alle stappen
// actief. Plan 3 maakt er op desktop een gepinde horizontale tijdlijn van.
type Props = { id: string, title: string, steps: Array<{ title: string, html: string }> }
const { id, title, steps } = $$props
const list = steps.map((step, index) => renderTemplate`
  <li class="timeline__step">
    <span class="timeline__num" aria-hidden="true">${String(index + 1).padStart(2, '0')}</span>
    <span class="timeline__dot" aria-hidden="true"></span>
    <h3 class="timeline__step-title">${step.title}</h3>
    <div class="timeline__text">${new SafeHtml(step.html)}</div>
  </li>`).join('')
---
<section class="timeline" data-motion="timeline" aria-labelledby={id}>
  <div class="container">
    <h2 class="timeline__title display" id={id}>{title}</h2>
  </div>
  <div class="timeline__body container">
    <div class="timeline__line" aria-hidden="true"><i></i></div>
    <ol class="timeline__track" role="list">{new SafeHtml(list)}</ol>
  </div>
</section>

<style>
.timeline {
  padding-block: var(--space-16);

  & .timeline__title {
    font-size: var(--text-xl);
  }
  & .timeline__body {
    position: relative;
    margin-top: var(--space-8);
  }
  & .timeline__line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--page-gutter) + 9px);
    width: 2px;
    background: linear-gradient(var(--accent), var(--accent-2));
  }
  & .timeline__line i {
    display: none;
  }
  & .timeline__track {
    display: grid;
    gap: var(--space-12);
    margin: 0;
    padding: 0 0 0 var(--space-12);
    list-style: none;
  }
  & .timeline__step {
    position: relative;
  }
  & .timeline__num {
    display: block;
    font-family: var(--font-display);
    font-size: 4.5rem;
    line-height: 1;
    color: var(--accent);
  }
  & .timeline__dot {
    position: absolute;
    top: 1.6rem;
    left: calc(-1 * var(--space-12));
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--accent);
  }
  & .timeline__step-title {
    margin-top: var(--space-4);
    font-size: var(--text-xl);
  }
  & .timeline__text {
    margin-top: var(--space-3);
    max-width: 60ch;
    color: var(--text-muted);
  }
  & .timeline__text > * + * {
    margin-top: var(--space-3);
  }

  /* Horizontale tijdlijn op desktop (motion.js zet .is-horizontal en .is-active per stap). */
  &.is-horizontal {
    min-height: 100vh;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: center;
    overflow: hidden;
  }
  &.is-horizontal > .container {
    width: 100%;
  }
  &.is-horizontal .timeline__body {
    justify-self: start;
    width: max-content;
    max-width: none;
    margin-top: var(--space-12);
    will-change: transform;
  }
  &.is-horizontal .timeline__track {
    display: flex;
    gap: 0;
    padding: 0;
  }
  &.is-horizontal .timeline__step {
    width: min(78vw, 44rem);
    padding-right: var(--space-24);
  }
  &.is-horizontal .timeline__num {
    height: 7rem;
    font-size: 7rem;
    color: transparent;
    -webkit-text-stroke: 1.5px #4a5266;
    transition: color 0.4s, -webkit-text-stroke-color 0.4s;
  }
  &.is-horizontal .timeline__line {
    top: 8rem;
    bottom: auto;
    left: 0;
    right: 0;
    width: auto;
    height: 2px;
    background: var(--border);
  }
  &.is-horizontal .timeline__line i {
    display: block;
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    transform-origin: left;
    transform: scaleX(0);
  }
  &.is-horizontal .timeline__dot {
    top: calc(8rem - 9px);
    left: 0;
    border: 2px solid #4a5266;
    background: var(--bg);
    transition: background 0.4s, border-color 0.4s;
  }
  &.is-horizontal .timeline__step-title {
    margin-top: var(--space-12);
    color: var(--text-muted);
    transition: color 0.4s;
  }
  &.is-horizontal .timeline__step.is-active .timeline__num {
    color: var(--accent);
    -webkit-text-stroke-color: transparent;
  }
  &.is-horizontal .timeline__step.is-active .timeline__dot {
    border-color: var(--accent);
    background: var(--accent);
  }
  &.is-horizontal .timeline__step.is-active .timeline__step-title {
    color: var(--text);
  }
}
</style>
