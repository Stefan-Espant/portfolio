---
// Bento-galerij met lightbox. Elk beeld is een link naar de afbeelding zelf: zonder JavaScript opent
// die gewoon; met /gallery.js opent een <dialog> met vorige/volgende, pijltjestoetsen en Esc.
import { accent, t, type Locale } from '../lib/i18n'
type Props = { id: string, title: string, images: Array<{ src: string, alt: string }>, locale: Locale }
const { id, title, images, locale } = $$props
// Vast ritme: het eerste beeld groot, daarna af en toe een brede of hoge tegel. grid-auto-flow: dense
// vult de gaten. Bij 2 of 3 beelden (desktop, mobiel, verderop) een eigen indeling zonder gaten:
// groot + hoog (2), of groot + twee hoog (3).
const SHAPES = ['', 'tall', '', 'wide', '', '', 'tall', 'wide']
const shape = (index: number) => (index === 0 ? 'big' : images.length <= 3 ? 'tall' : SHAPES[index % SHAPES.length])
const layout = images.length <= 3 ? String(images.length) : 'many'
const items = images.map((image, index) => renderTemplate`<li class="gallery__item${shape(index) ? ` gallery__item--${shape(index)}` : ''}">
  <a class="gallery__link" href="${image.src}" data-gallery-index="${String(index)}" aria-label="${image.alt ? `${t('gallery.view', locale)}: ${image.alt}` : t('gallery.view', locale)}">
    <img src="${image.src}" alt="" loading="lazy" decoding="async">
    ${new SafeHtml(image.alt ? renderTemplate`<span class="gallery__caption" aria-hidden="true">${image.alt}</span>` : '')}
  </a>
</li>`).join('')
const data = JSON.stringify(images).replace(/</g, '\\u003c')
const dataTag = `<script type="application/json" data-gallery-images data-wald-no-hoist>${data}</script>`
---
<section class="gallery container" aria-labelledby={id} data-gallery>
  <div class="section-head">
    <h2 class="section-title" id={id} data-motion="reveal">{new SafeHtml(accent(title))}</h2>
    <p class="section-note">{String(images.length)} {t('gallery.images', locale)}</p>
  </div>
  <ul class="gallery__grid" role="list" data-layout={layout} data-motion="rise">{new SafeHtml(items)}</ul>
  {new SafeHtml(dataTag)}
  <dialog class="lightbox" aria-label={t('gallery.dialog', locale)} data-lightbox>
    <figure class="lightbox__figure">
      <img class="lightbox__img" src="data:," alt="" data-lightbox-img>
      <figcaption class="lightbox__caption"><span data-lightbox-caption></span> <span class="lightbox__count" data-lightbox-count></span></figcaption>
    </figure>
    <button class="lightbox__btn lightbox__close" type="button" aria-label={t('gallery.close', locale)} data-lightbox-close>✕</button>
    <button class="lightbox__btn lightbox__prev" type="button" aria-label={t('gallery.prev', locale)} data-lightbox-prev>←</button>
    <button class="lightbox__btn lightbox__next" type="button" aria-label={t('gallery.next', locale)} data-lightbox-next>→</button>
  </dialog>
</section>
<script src="/gallery.js" defer data-wald-no-hoist></script>

<style>
.gallery {
  margin-top: var(--space-24);

  & .gallery__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: clamp(9rem, 22vw, 15rem);
    grid-auto-flow: dense;
    gap: var(--space-3);
    list-style: none;

    @media (min-width: 48rem) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-4);
    }
  }
  /* Kleine aantallen: kolommen die precies vol lopen. */
  & .gallery__grid[data-layout='1'] {
    grid-template-columns: minmax(0, 1fr);
  }
  & .gallery__grid[data-layout='1'] .gallery__item--big {
    grid-column: auto;
  }
  & .gallery__grid[data-layout='2'] {
    grid-template-columns: minmax(0, 3fr) minmax(0, 1fr);
  }
  & .gallery__grid[data-layout='2'] .gallery__item--big {
    grid-column: auto;
  }
  /* 3 beelden: op mobiel groot bovenaan met twee hoge eronder, op desktop alles naast elkaar. */
  & .gallery__grid[data-layout='3'] {
    @media (min-width: 48rem) {
      grid-template-columns: minmax(0, 3fr) repeat(2, minmax(0, 1fr));
    }
  }
  & .gallery__grid[data-layout='3'] .gallery__item--big {
    @media (min-width: 48rem) {
      grid-column: auto;
    }
  }
  & .gallery__item--big {
    grid-column: span 2;
    grid-row: span 2;
  }
  & .gallery__item--tall {
    grid-row: span 2;
  }
  & .gallery__item--wide {
    grid-column: span 2;
  }
  & .gallery__link {
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--card);
    box-shadow: var(--edge);
  }
  & .gallery__link img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
  }
  & .gallery__caption {
    position: absolute;
    inset: auto 0 0;
    padding: var(--space-8) var(--space-4) var(--space-3);
    color: #fff;
    font-size: var(--text-sm);
    line-height: 1.35;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.7));
    opacity: 0;
  }
  & .gallery__link:hover .gallery__caption,
  & .gallery__link:focus-visible .gallery__caption {
    opacity: 1;
  }
  & .gallery__link:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: no-preference) {
    & .gallery__link img {
      transition: transform 0.6s var(--ease-out);
    }
    & .gallery__link:hover img {
      transform: scale(1.04);
    }
    & .gallery__caption {
      transition: opacity 0.25s;
    }
  }

  /* Lightbox */
  & .lightbox {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: clamp(3.5rem, 6vw, 5rem) clamp(1rem, 7vw, 6rem);
    border: 0;
    color: #fff;
    background: transparent;
  }
  & .lightbox::backdrop {
    background: rgb(8 10 30 / 0.88);
    backdrop-filter: blur(6px);
  }
  & .lightbox[open] {
    display: grid;
    place-items: center;
  }
  & .lightbox__figure {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    max-width: 100%;
    max-height: 100%;
    min-height: 0;
  }
  & .lightbox__img {
    max-width: 100%;
    max-height: calc(100dvh - 10rem);
    width: auto;
    height: auto;
    border-radius: 8px;
    box-shadow: 0 30px 80px -20px rgb(0 0 0 / 0.6);
  }
  & .lightbox__caption {
    max-width: 60ch;
    text-align: center;
    font-size: var(--text-sm);
    color: rgb(255 255 255 / 0.85);
  }
  & .lightbox__count {
    margin-left: var(--space-2);
    color: rgb(255 255 255 / 0.55);
    font-variant-numeric: tabular-nums;
  }
  & .lightbox__btn {
    position: fixed;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 0;
    border-radius: 999px;
    color: #fff;
    font-size: 1.15rem;
    background: rgb(255 255 255 / 0.12);
    cursor: pointer;
  }
  & .lightbox__btn:hover {
    background: rgb(255 255 255 / 0.22);
  }
  & .lightbox__btn:focus-visible {
    outline: 3px solid #a9c4ff;
    outline-offset: 2px;
  }
  & .lightbox__close {
    top: var(--space-4);
    right: var(--space-4);
  }
  & .lightbox__prev,
  & .lightbox__next {
    top: 50%;
    translate: 0 -50%;
  }
  & .lightbox__prev {
    left: var(--space-4);
  }
  & .lightbox__next {
    right: var(--space-4);
  }
  /* Op smalle schermen de pijlen onderaan, zodat ze niet over het beeld liggen. */
  @media (max-width: 47.99rem) {
    & .lightbox__prev,
    & .lightbox__next {
      top: auto;
      bottom: var(--space-4);
      translate: none;
    }
    & .lightbox__img {
      max-height: calc(100dvh - 14rem);
    }
  }
  & .lightbox__btn[hidden] {
    display: none;
  }

  @media (forced-colors: active) {
    & .lightbox__btn {
      border: 1px solid ButtonText;
    }
  }
}
</style>
