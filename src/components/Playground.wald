---
// .wald-playground op de case study van WaldJS (spec 2026-10-12, Extra's). Links een bewerkbaar
// .wald-bestand, rechts het resultaat in een sandbox-iframe. Zonder JavaScript blijft de sectie verborgen.
import { accent, t, type Locale } from '../lib/i18n'
type Props = { locale: Locale }
const { locale } = $$props
const example = locale === 'nl'
  ? `---\nconst titel = "Mijn eerste boom"\nconst soorten = ["eik", "beuk", "den"]\n---\n<h1>{titel}</h1>\n<p>Er groeien {soorten.length} soorten in dit bos:</p>\n<ul>\n  {soorten.map(s => '<li>' + s + '</li>').join('')}\n</ul>`
  : `---\nconst title = "My first tree"\nconst species = ["oak", "beech", "pine"]\n---\n<h1>{title}</h1>\n<p>{species.length} species grow in this forest:</p>\n<ul>\n  {species.map(s => '<li>' + s + '</li>').join('')}\n</ul>`
const file = locale === 'nl' ? 'speeltuin.wald' : 'playground.wald'
---
<section class="playground container" aria-labelledby="playground-title" data-playground hidden>
  <div class="section-head">
    <h2 class="section-title" id="playground-title" data-motion="reveal">{new SafeHtml(accent(t('playground.title', locale)))}</h2>
    <p class="section-note playground__lead">{t('playground.lead', locale)}</p>
  </div>
  <div class="playground__grid">
    <div class="playground__code">
      <p class="playground__file"><span aria-hidden="true"></span>{file}</p>
      <textarea class="playground__editor" spellcheck="false" autocapitalize="off" aria-label={t('playground.editor', locale)}>{example}</textarea>
    </div>
    <iframe class="playground__preview card" title={t('playground.preview', locale)} sandbox="" data-playground-preview></iframe>
  </div>
</section>

<style>
.playground {
  & .playground__lead {
    max-width: 38ch;
    font-size: var(--text-base);
    font-weight: 400;
  }
  & .playground__grid {
    display: grid;
    gap: var(--space-4);

    @media (min-width: 56rem) {
      grid-template-columns: 1fr 1fr;
    }
  }
  & .playground__code {
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border-radius: var(--radius);
    background: #16161a;
    color: #f1f0ec;
  }
  & .playground__file {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.8rem 1.1rem;
    border-bottom: 1px solid rgb(241 240 236 / 0.1);
    color: #a3a3ab;
    font: 500 0.8125rem / 1 var(--font-mono);
  }
  & .playground__file span {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--grad-on-dark);
  }
  & .playground__editor {
    width: 100%;
    min-height: 21rem;
    padding: 1.1rem 1.25rem;
    border: 0;
    background: transparent;
    color: inherit;
    font: 0.875rem / 1.7 var(--font-mono);
    resize: vertical;
    tab-size: 2;
  }
  & .playground__editor:focus-visible {
    outline: 2px solid var(--byz-brand-300);
    outline-offset: -2px;
  }
  & .playground__preview {
    width: 100%;
    height: 100%;
    min-height: 21rem;
    border: 0;
  }
}
</style>
