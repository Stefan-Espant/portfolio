---
import { accent } from '../lib/i18n'
import type { Metric } from '../lib/content'
type Props = { id: string, title: string, metrics: Metric[] }
const { id, title, metrics } = $$props
const items = metrics.map(metric =>
  renderTemplate`<li class="metrics__item"><strong class="metrics__value" data-motion="count">${metric.value}</strong><span class="metrics__label">${metric.label}</span></li>`).join('')
---
<section class="metrics container" aria-labelledby={id}>
  <div class="section-head"><h2 class="section-title" id={id} data-motion="reveal">{new SafeHtml(accent(title))}</h2></div>
  <ul class="metrics__list" role="list" data-motion="rise">{new SafeHtml(items)}</ul>
</section>

<style>
.metrics {
  & .metrics__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }
  & .metrics__item {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: 1.625rem;
    border-radius: var(--radius);
    background: var(--card);
    box-shadow: var(--edge);
  }
  & .metrics__value {
    font-family: var(--font-display);
    font-size: clamp(3rem, 2.4rem + 2.4vw, 4.5rem);
    font-weight: 600;
    font-stretch: 85%;
    letter-spacing: -0.05em;
    line-height: 1;
  }
  & .metrics__label {
    color: var(--muted);
  }
}
</style>
