---
import Layout from '../../layouts/Layout.wald'
import { getPost, getPosts, postAlternates, readingMinutes } from '../../lib/content'
import { formatDate, localePath, t, type Locale } from '../../lib/i18n'
type Props = { locale: Locale, slug: string }
const { locale, slug } = $$props
const [post, posts] = await Promise.all([getPost(slug, locale), getPosts(locale)])
if (!post) throw new Error(`Blogpost "${slug}" (${locale}) staat niet (gepubliceerd) in Centaur`)
const alternates = await postAlternates(post)
const tags = post.tags.length ? `<ul class="tags post__tags" role="list">${post.tags.map(tag => renderTemplate`<li class="tag">${tag}</li>`).join('')}</ul>` : ''
const cover = post.cover ? renderTemplate`<div class="container"><img class="post__cover" src="${post.cover}" alt="${post.coverAlt}" decoding="async" fetchpriority="high"></div>` : ''
const date = post.publishedAt ? renderTemplate`<time datetime="${post.publishedAt}">${formatDate(post.publishedAt, locale)}</time>` : ''
const minutes = t('post.readingTime', locale).replace('{n}', String(readingMinutes(post.bodyHtml)))
const byline = [renderTemplate`<span>Stefan</span>`, date, renderTemplate`<span>${minutes}</span>`].filter(Boolean).join('<span aria-hidden="true">·</span>')

// Volgend artikel: het eerstvolgende oudere, anders het nieuwste.
const index = posts.findIndex(item => item.slug === post.slug)
const next = posts.length > 1 ? posts[(index + 1) % posts.length] : null
const nextHtml = next
  ? renderTemplate`<section class="container post__next" aria-label="${t('post.next', locale)}">
      <a class="card post__next-link" href="${localePath('post', locale, next.slug)}">
        <span class="label">${t('post.next', locale)}</span>
        <span class="post__next-title">${next.title}</span>
        <span class="label">${t('post.readingTime', locale).replace('{n}', String(readingMinutes(next.bodyHtml)))}</span>
      </a>
    </section>`
  : ''
---
<Layout title={post.title} description={post.excerpt} path={localePath('post', locale, post.slug)} locale={locale} alternates={alternates} current="blog">
  <main id="main" class="post">
    <article>
      <header class="post__header container" data-motion="intro">
        <nav class="post__crumb" aria-label={t('nav.breadcrumb', locale)}><a href={localePath('blog', locale)}>{t('post.back', locale)}</a></nav>
        <h1 class="post__title">{post.title}</h1>
        <p class="post__byline"><span class="post__avatar" aria-hidden="true"></span>{new SafeHtml(byline)}</p>
        {new SafeHtml(tags)}
      </header>
      {new SafeHtml(cover)}
      <div class="container"><div class="post__body">{new SafeHtml(post.bodyHtml)}</div></div>
    </article>
    {new SafeHtml(nextHtml)}
  </main>
</Layout>

<style>
.post {
  --measure: 55rem;

  & .post__header {
    display: grid;
    gap: var(--space-6);
    max-width: calc(var(--measure) + 2 * var(--page-gutter));
    padding-block: clamp(3rem, 8vw, 6rem) var(--space-8);
  }
  & .post__crumb {
    color: var(--muted);
    font-size: var(--text-sm);
  }
  & .post__title {
    font-size: clamp(2.5rem, 1.5rem + 4.5vw, 5rem);
  }
  & .post__byline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    color: var(--muted);
    font-size: var(--text-sm);
  }
  & .post__avatar {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--grad);
  }
  & .post__cover {
    width: 100%;
    max-height: 36rem;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }
  /* Lopende tekst in Fraunces op leesmaat; koppen in Bricolage. */
  & .post__body {
    max-width: var(--measure);
    margin: var(--space-12) auto 0;
    font-family: var(--font-serif);
    font-variation-settings: var(--serif-text);
    font-size: 1.25rem;
    line-height: 1.7;
  }
  & .post__body > * + * {
    margin-top: 1.1em;
  }
  & .post__body h2,
  & .post__body h3 {
    margin-top: 2em;
    font-size: 2.1rem;
    line-height: 1.1;
  }
  & .post__body h3 {
    font-size: 1.6rem;
  }
  & .post__body > p:first-of-type::first-letter {
    float: left;
    margin: 0.06em 0.04em 0 0;
    font-family: var(--font-display);
    font-size: 4.2em;
    font-weight: 600;
    font-stretch: 85%;
    line-height: 0.82;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  & .post__body a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  & .post__body blockquote {
    margin-block: 2em;
    padding: 0.25rem 0 0.25rem 1.6rem;
    border-left: 3px solid;
    border-image: var(--grad) 1;
    font-style: italic;
    font-variation-settings: 'opsz' 72, 'SOFT' 0, 'WONK' 0;
    font-size: 1.6rem;
    line-height: 1.4;
  }
  & .post__body pre {
    overflow-x: auto;
    padding: 1.25rem 1.4rem;
    border-radius: 14px;
    background: var(--ink);
    color: var(--bg);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  & .post__body :not(pre) > code {
    padding: 0.1em 0.35em;
    border-radius: 6px;
    background: var(--card);
    box-shadow: var(--edge);
    font-size: 0.82em;
  }
  & .post__body img {
    border-radius: var(--radius);
  }
  & .post__body ul,
  & .post__body ol {
    padding-left: 1.4em;
  }
  & .post__next {
    margin-top: var(--space-24);
  }
  & .post__next-link {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-8);
  }
  & .post__next-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.75rem);
    font-weight: 600;
    font-stretch: 85%;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }
  /* Genest: pre en p komen uit de Centaur-HTML en hebben geen scope-attribuut. */
  [data-theme='dark'] & .post__body pre {
    background: var(--card);
    color: var(--ink);
  }
  @media (forced-colors: active) {
    & .post__body > p:first-of-type::first-letter { background: none; color: CanvasText; }
  }
}
</style>
