---
import { accent, t, type Locale } from '../lib/i18n'
import type { Client } from '../lib/content'
type Props = { clients: Client[], locale: Locale }
const { clients, locale } = $$props
const items = clients.map(client => {
  const inner = client.logo
    ? renderTemplate`<img src="${client.logo}" alt="${client.name}" loading="lazy" decoding="async">`
    : renderTemplate`<span>${client.name}</span>`
  return client.url
    ? renderTemplate`<li><a href="${client.url}">${new SafeHtml(inner)}</a></li>`
    : renderTemplate`<li>${new SafeHtml(inner)}</li>`
}).join('')
const withQuote = clients.find(client => client.quote)
const quote = withQuote
  ? renderTemplate`<blockquote class="clients__quote"><p>${withQuote.quote}</p><footer>${withQuote.quoteAuthor || withQuote.name}</footer></blockquote>`
  : ''
---
<section class="clients container" aria-labelledby="clients-title">
  <div class="section-head"><h2 class="section-title" id="clients-title" data-motion="reveal">{new SafeHtml(accent(t('home.clients', locale)))}</h2></div>
  <ul class="clients__list" role="list">{new SafeHtml(items)}</ul>
  {new SafeHtml(quote)}
</section>

<style>
.clients {
  & .clients__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }
  & .clients__list li {
    display: grid;
    place-items: center;
    min-height: 4.5rem;
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius);
    background: var(--card);
    box-shadow: var(--edge);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    font-stretch: 85%;
    letter-spacing: -0.03em;
  }
  & .clients__list img {
    height: 2rem;
    width: auto;
  }
  & .clients__quote {
    max-width: 46rem;
    margin-top: var(--space-8);
    padding: var(--space-6) 0 var(--space-6) var(--space-8);
    border-left: 3px solid;
    border-image: var(--grad) 1;
  }
  & .clients__quote p {
    font-family: var(--font-serif);
    font-style: italic;
    font-variation-settings: 'opsz' 72, 'SOFT' 0, 'WONK' 0;
    font-size: clamp(1.4rem, 1.1rem + 1vw, 1.9rem);
    line-height: 1.3;
    letter-spacing: -0.01em;
    quotes: '“' '”';
  }
  & .clients__quote p::before { content: open-quote; }
  & .clients__quote p::after { content: close-quote; }
  & .clients__quote footer {
    margin-top: var(--space-3);
    color: var(--muted);
    font-size: var(--text-sm);
  }
}
</style>
