---
// Decoratieve band met projectnamen (spec 2026-11-15, Motion: marquee). Alleen sier: aria-hidden.
type Props = { names: string[] }
const { names } = $$props
// Per naam vast (niet nth-child): bij een oneven aantal namen zou elke kopie anders ogen en de lus springen.
const run = names.map((name, index) => index % 2 ? renderTemplate`<span class="marquee__alt">${name}</span>` : renderTemplate`<span>${name}</span>`).join('')
---
<div class="marquee" aria-hidden="true" data-motion="marquee">
  <div class="marquee__track">{new SafeHtml(run + run + run)}</div>
</div>

<style>
.marquee {
  overflow: hidden;
  margin-top: var(--space-24);
  padding-block: var(--space-6);
  border-block: 1px solid var(--line);
  white-space: nowrap;

  & .marquee__track {
    display: inline-flex;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 1.5rem + 4vw, 5.25rem);
    font-weight: 600;
    font-stretch: 80%;
    letter-spacing: -0.04em;
    line-height: 1.25;
    will-change: transform;
  }
  & .marquee__track span {
    padding-right: 0.6em;
  }
  /* Elke tweede naam in scherpe Fraunces cursief met het verloop. background-clip: text kleurt alleen binnen het
     kader van het element: als inline-block met ruimte boven, onder en links vallen de staarten (j, p, y) en
     de cursieve overhang (J) erbinnen in plaats van afgekapt te worden. De negatieve marges houden de
     tussenruimte in de strook gelijk. */
  & .marquee__alt {
    display: inline-block;
    padding: 0.1em 0.7em 0.3em 0.15em;
    margin-block: -0.1em -0.3em;
    margin-left: -0.15em;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-stretch: normal;
    font-variation-settings: var(--serif-sharp);
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  @media (forced-colors: active) {
    & .marquee__alt { background: none; color: CanvasText; }
  }
}
</style>
